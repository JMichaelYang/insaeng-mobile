{
  "id": "home",
  "state": { "count": 0 },
  "root": {
    "type": "column",
    "id": "root",
    "children": [
      { "type": "appBar", "id": "appBar", "title": "Insaeng" },
      {
        "type": "scroll",
        "id": "scroll",
        "child": {
          "type": "container",
          "id": "content",
          "padding": "md",
          "alignment": "center",
          "child": {
            "type": "column",
            "id": "counter",
            "spacing": "md",
            "alignment": "center",
            "children": [
              { "type": "text", "id": "count", "text": { "$bind": "count" }, "style": "displayMedium" },
              { "type": "divider", "id": "divider" },
              {
                "type": "row",
                "id": "controls",
                "spacing": "sm",
                "alignment": "center",
                "children": [
                  {
                    "type": "button",
                    "id": "reset",
                    "label": "Reset",
                    "variant": "secondary",
                    "onTap": [{ "type": "updateState", "path": "count", "op": "set", "value": 0 }]
                  },
                  { "type": "spacer", "id": "controlsSpacer" },
                  {
                    "type": "button",
                    "id": "add",
                    "label": "Add",
                    "onTap": [{ "type": "updateState", "path": "count", "op": "increment" }]
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
